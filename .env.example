# Copy to .env.local for local dev (never commit .env.local)
# Same backend as language-learning-tts-phrasebook — values must match that Lambda.

# Shared secret for HMAC-TOTP token generation (must match Lambda HMAC_SECRET)
VITE_HMAC_SECRET=your-hmac-secret-here

# Lambda Function URL (from SAM deploy output: LambdaFunctionUrl)
VITE_LAMBDA_URL=https://xxxxxxxxxxxxxxxx.lambda-url.ap-southeast-2.on.aws

# S3 audio base URL (from SAM deploy output: AudioBaseUrl)
VITE_AUDIO_BASE_URL=https://your-bucket-name.s3.amazonaws.com
